# Скопируй этот файл в .env и заполни своими данными
# cp .env.example .env

# Данные API Telegram — получить на https://my.telegram.org (API development tools)
API_ID=1234567
API_HASH=вставь_сюда_свой_api_hash

# Название стикерсета (короткое имя, латиница) и заголовок
STICKERSET_NAME=my_stickerset
STICKERSET_TITLE=Мой стикерсет

# (Необязательно) ID канала, куда пересылать добавленные стикеры
CHANNEL_ID=
